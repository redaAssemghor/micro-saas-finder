# Local inference. Install Ollama, then run: ollama pull qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional model sizes: ollama pull qwen3.5:4b / ollama pull qwen3.5:27b

# Optional account authentication. Configure both, or omit both for guest mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required for profile persistence on serverless production deployments.
# Run supabase/schema.sql first. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local development stores account plans in .data/plans.
# Persistent single-server production only; never use ephemeral/serverless disks.
# ALLOW_LOCAL_PLAN_STORAGE=true
# PLAN_STORAGE_DIR=/persistent/private/startup-plans
